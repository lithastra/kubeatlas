# Canonical coordinates for the CloudNativePG-compatible PostgreSQL + AGE
# dependency image. Keep the recipe revision in the tag: if Dockerfile changes,
# bump POSTGRES_AGE_TAG before a release. The release contract enforces that
# rule against the previous Git release tag.
POSTGRES_AGE_REPOSITORY=ghcr.io/lithastra/postgres-age
POSTGRES_AGE_TAG=16.15-age1.6.0-rc0.2
